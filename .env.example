# Hosted backend. Set the same variables in Northflank's runtime environment.
COACH_ACCESS_TOKEN=
COACH_ALLOWED_HOSTS=coach.example.com,127.0.0.1

# Google Gemini
COACH_PROVIDER=gemini
GEMINI_API_KEY=
# COACH_MODEL=gemini-2.5-flash

# To use Groq, replace the Gemini settings above with these.
# COACH_PROVIDER=groq
# COACH_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=

# Public API service (create a separate Northflank service; don't switch your private one).
# COACH_AUTH_MODE=users
# AUTH_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# AUTH_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# COACH_REDIS_URL=rediss://USERNAME:PASSWORD@REDIS_HOST:PORT/0
# COACH_USER_PER_MINUTE=5
# COACH_USER_PER_DAY=30
# COACH_IP_PER_MINUTE=180
# COACH_GLOBAL_PER_DAY=1000
# Public mode needs Supabase Auth with verified emails + custom SMTP and shared Redis.
# Keep GEMINI_API_KEY server-side. Do not distribute COACH_ACCESS_TOKEN.
