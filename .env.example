# Hosted backend. Set the same variables in Northflank's runtime environment.
COACH_ACCESS_TOKEN=
COACH_ALLOWED_HOSTS=coach.example.com,127.0.0.1

# Google Gemini
COACH_PROVIDER=gemini
GEMINI_API_KEY=
# COACH_MODEL=gemini-2.5-flash
# COACH_VIDEO_MODEL=gemini-2.5-flash    # optional override for video analysis
# Reference video analyses share a global budget. Configure COACH_REDIS_URL
# for shared counters across instances and restarts (required in demo mode).
# COACH_VIDEO_GLOBAL_PER_MINUTE=3
# COACH_VIDEO_GLOBAL_PER_DAY=20

# To use Groq, replace the Gemini settings above with these.
# COACH_PROVIDER=groq
# COACH_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=

# Judge demo service: separate backend, anonymous access with strict Redis quotas.
# COACH_AUTH_MODE=demo
# COACH_REDIS_URL=rediss://USERNAME:PASSWORD@PRIVATE_REDIS_HOST:PORT/0
# COACH_DEMO_GLOBAL_PER_DAY=100    # explicitly required (cap <= 1000)
# COACH_DEMO_GLOBAL_PER_MINUTE=20
# COACH_DEMO_IP_PER_MINUTE=8
# COACH_DEMO_IP_PER_DAY=60
# Do not set COACH_ACCESS_TOKEN in demo mode. Keep GEMINI_API_KEY server-side.
#
